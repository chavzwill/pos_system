{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/app-shell.html"
    },
    {
      "source": "/index.html",
      "destination": "/app-shell.html"
    }
  ]
}
