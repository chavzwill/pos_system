# Host deployment values only. Copy to .env on the production host.
# Never commit the real .env file.

# Public DNS hostname that points to the production server.
# Example: pos.example.com
POS_DOMAIN=pos.example.com

# Optional explicit cross-origin API allowlist. Leave blank for the normal
# same-origin POS deployment. Multiple origins are comma-separated.
POS_ALLOWED_ORIGINS=

# FIRST SECURED STARTUP ONLY:
# If the existing admin credential is missing/weak, production startup fails
# closed until both values below meet policy. After the first successful
# secured startup, remove these two values from .env and change the password
# through the POS so bootstrap secrets do not remain on disk.
# Password: >=12 chars with upper/lowercase, number and symbol.
# PIN: 6-10 digits, not a repeated/sequential/common value.
POS_BOOTSTRAP_ADMIN_USER=admin
POS_BOOTSTRAP_ADMIN_PASSWORD=
POS_BOOTSTRAP_ADMIN_PIN=

# Only needed if docker-compose.yml is changed from local SQLite to remote Turso.
TURSO_AUTH_TOKEN=
