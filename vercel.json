{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/app-shell.html",
      "headers": {
        "cache-control": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
      }
    },
    {
      "src": "^/index\\.html$",
      "dest": "/app-shell.html",
      "headers": {
        "cache-control": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
