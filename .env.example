# Copy to .env (already gitignored) and fill in real values.

# Only needed if you switch database.js off the local-SQLite-in-volume setup
# (see docker-compose.yml) and back to Turso.
# TURSO_AUTH_TOKEN=


# TT AI standalone service connection.
# The private Ed25519 key belongs ONLY on the POS server.
# Use literal \n for PEM newlines if your environment provider requires one-line values.
# TT_AI_SERVICE_URL=http://127.0.0.1:8787
# TT_AI_SIGNING_PRIVATE_KEY=
